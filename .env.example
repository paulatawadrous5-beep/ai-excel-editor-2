# ---------------------------------------------------------------------------
# AI Excel Editor - environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# REQUIRED: API key for the AI provider used to turn natural-language
# instructions into structured Excel operations.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for instruction -> operations conversion.
AI_MODEL=claude-sonnet-5

# Anthropic API base URL (rarely needs to change).
ANTHROPIC_API_BASE=https://api.anthropic.com/v1/messages

# Port the server listens on.
PORT=3000

# Comma-separated list of origins allowed to call the API (CORS).
# Use "*" only for local development.
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size in megabytes.
MAX_UPLOAD_MB=15

# Directory (relative or absolute) used for temporary uploaded/generated files.
TEMP_DIR=./tmp

# Minutes a generated file / session stays available before it is deleted.
FILE_TTL_MINUTES=30

# Rate limiting: max requests per IP per window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
